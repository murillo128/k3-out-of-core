{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/murillo128/k3-out-of-core/schemas/phase3/phase3-manifest-v2.schema.json",
  "title": "K3 Phase 3 accepted-with-notes closeout manifest version 2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "closeout_state", "execution_profile", "issue", "revisions",
    "raw_performance_gate", "design_disposition", "models", "phase2_input",
    "artifacts", "validation", "reviews", "prohibited_scope"
  ],
  "properties": {
    "schema_version": {"const": "phase3-manifest-v2"},
    "closeout_state": {"enum": ["checkpoint-b-candidate-with-performance-notes", "complete-with-performance-notes"]},
    "execution_profile": {"const": "STANDARD"},
    "issue": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "number", "url", "pull_request"],
      "properties": {
        "repository": {"const": "murillo128/k3-out-of-core"}, "number": {"const": 13},
        "url": {"type": "string", "format": "uri"}, "pull_request": {"const": 15}
      }
    },
    "revisions": {
      "type": "object", "additionalProperties": false,
      "required": [
        "project_execution_base", "project_evidence_head", "llama_cpp_base",
        "llama_cpp_candidate", "published_gguf", "published_corpus"
      ],
      "properties": {
        "project_execution_base": {"$ref": "#/$defs/sha1"},
        "project_evidence_head": {"$ref": "#/$defs/sha1"},
        "project_checkpoint_b_head": {"$ref": "#/$defs/sha1"},
        "llama_cpp_base": {"$ref": "#/$defs/sha1"},
        "llama_cpp_candidate": {"$ref": "#/$defs/sha1"},
        "published_gguf": {"$ref": "#/$defs/sha1"},
        "published_corpus": {"$ref": "#/$defs/sha1"}
      }
    },
    "raw_performance_gate": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "passed_cells", "total_cells", "capture_path", "capture_sha256"],
      "properties": {
        "status": {"const": "fail"}, "passed_cells": {"const": 22}, "total_cells": {"const": 24},
        "capture_path": {"const": "results/2026-07-29/skynet/phase3-resident-provider/provider-overhead-post-optimization.json"},
        "capture_sha256": {"const": "23eff115b87a9e8cee101bd1c0b02f299786175e786b4b30dd4a7e66617d4970"}
      }
    },
    "design_disposition": {
      "type": "object", "additionalProperties": false,
      "required": ["status", "progression_scope", "path", "size", "sha256", "comment_ids"],
      "properties": {
        "status": {"const": "accepted-with-notes"}, "progression_scope": {"const": "phase3-only"},
        "path": {"const": "results/2026-07-29/skynet/phase3-resident-provider/phase3-disposition.json"},
        "size": {"type": "integer", "minimum": 1}, "sha256": {"$ref": "#/$defs/sha256"},
        "comment_ids": {"const": [5128658370, 5128726338]}
      }
    },
    "models": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"$ref": "#/$defs/file_identity"}},
    "phase2_input": {
      "type": "object", "additionalProperties": false,
      "required": ["path", "size", "sha256", "published_corpus", "raw_corpus_republished"],
      "properties": {
        "path": {"type": "string", "minLength": 1}, "size": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}, "published_corpus": {"$ref": "#/$defs/sha1"},
        "raw_corpus_republished": {"const": false}
      }
    },
    "artifacts": {"type": "array", "minItems": 10, "items": {"$ref": "#/$defs/artifact"}},
    "validation": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["name", "status", "evidence"],
        "properties": {
          "name": {"type": "string", "minLength": 1}, "status": {"enum": ["pass", "fail"]},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "reviews": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/review"}},
    "prohibited_scope": {
      "type": "object", "additionalProperties": false,
      "required": [
        "cache_added", "storage_or_transport_added", "prefetch_added",
        "expert_residency_changed", "raw_phase2_corpus_modified", "model_payload_tracked"
      ],
      "properties": {
        "cache_added": {"const": false}, "storage_or_transport_added": {"const": false},
        "prefetch_added": {"const": false}, "expert_residency_changed": {"const": false},
        "raw_phase2_corpus_modified": {"const": false}, "model_payload_tracked": {"const": false}
      }
    }
  },
  "$defs": {
    "sha1": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "file_identity": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "size", "sha256", "source_revision"],
      "properties": {
        "name": {"type": "string", "minLength": 1}, "size": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}, "source_revision": {"$ref": "#/$defs/sha1"}
      }
    },
    "artifact": {
      "type": "object", "additionalProperties": false, "required": ["path", "size", "sha256", "kind"],
      "properties": {
        "path": {"type": "string", "minLength": 1}, "size": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"},
        "kind": {"enum": ["schema", "implementation", "test", "evidence", "source-of-truth"]}
      }
    },
    "review": {
      "type": "object", "additionalProperties": false,
      "required": ["checkpoint", "comment_id", "url", "verdict", "safety_to_proceed", "project_head", "llama_cpp_head"],
      "properties": {
        "schema_version": {"const": "checkpoint-b-review-v1"},
        "repository": {"const": "murillo128/k3-out-of-core"}, "issue": {"const": 13},
        "execution_profile": {"const": "STANDARD"}, "checkpoint": {"enum": ["A", "B"]},
        "comment_id": {"type": "integer", "minimum": 1}, "url": {"type": "string", "format": "uri"},
        "verdict": {"enum": ["PASS", "PASS_WITH_NOTES"]}, "safety_to_proceed": {"const": "YES"},
        "project_head": {"$ref": "#/$defs/sha1"}, "llama_cpp_head": {"$ref": "#/$defs/sha1"},
        "project_range": {"type": "string"}, "llama_cpp_range": {"type": "string"},
        "independent_read_only": {"const": true}
      }
    }
  }
}
