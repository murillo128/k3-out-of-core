{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/murillo128/k3-out-of-core/schemas/phase2/phase2-manifest-v1.schema.json",
  "title": "K3 Phase 2 authoritative closeout manifest version 1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "closeout_state", "execution_profile", "issue", "revisions",
    "models", "artifacts", "external_archive", "validation", "reviews", "prohibited_scope"
  ],
  "properties": {
    "schema_version": {"const": "phase2-manifest-v1"},
    "closeout_state": {"enum": ["checkpoint-b-candidate", "complete"]},
    "execution_profile": {"const": "STANDARD"},
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": ["repository", "number", "url", "pull_request"],
      "properties": {
        "repository": {"const": "murillo128/k3-out-of-core"},
        "number": {"const": 10},
        "url": {"type": "string", "format": "uri"},
        "pull_request": {"const": 11}
      }
    },
    "revisions": {"type": "object"},
    "models": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": {"$ref": "#/$defs/file_identity"}
    },
    "artifacts": {
      "type": "array",
      "minItems": 20,
      "items": {"$ref": "#/$defs/artifact"}
    },
    "external_archive": {
      "type": "object",
      "required": ["repository", "revision", "path", "size", "sha256", "members"]
    },
    "validation": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "status", "evidence"],
        "properties": {
          "name": {"type": "string", "minLength": 1},
          "status": {"const": "pass"},
          "evidence": {"type": "string", "minLength": 1}
        }
      }
    },
    "reviews": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "checkpoint", "comment_id", "url", "verdict", "safety_to_proceed",
          "project_head", "llama_cpp_head"
        ],
        "properties": {
          "checkpoint": {"enum": ["A", "B"]},
          "comment_id": {"type": "integer", "minimum": 1},
          "url": {"type": "string", "format": "uri"},
          "verdict": {"enum": ["PASS", "PASS_WITH_NOTES"]},
          "safety_to_proceed": {"const": "YES"},
          "project_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
          "llama_cpp_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
        }
      }
    },
    "prohibited_scope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["runtime_provider_or_cache_added", "raw_corpus_tracked", "model_payload_tracked"],
      "properties": {
        "runtime_provider_or_cache_added": {"const": false},
        "raw_corpus_tracked": {"const": false},
        "model_payload_tracked": {"const": false}
      }
    }
  },
  "$defs": {
    "file_identity": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "size", "sha256", "source_revision"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "size": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "source_revision": {"type": "string", "pattern": "^[0-9a-f]{40}$"}
      }
    },
    "artifact": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size", "sha256", "kind"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "size": {"type": "integer", "minimum": 1},
        "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "kind": {"enum": ["schema", "implementation", "test", "fixture", "evidence", "prompt", "source-of-truth"]}
      }
    }
  }
}
