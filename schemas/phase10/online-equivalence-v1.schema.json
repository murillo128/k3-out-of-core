{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "online-equivalence-v1.schema.json",
  "title": "Phase 10 online prefetch equivalence v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "project_head", "nested_head", "capture_schema", "cases"],
  "properties": {
    "schema_version": {"const": "phase10-online-equivalence-v1"},
    "status": {"const": "pass"},
    "project_head": {"$ref": "#/$defs/commit"},
    "nested_head": {"$ref": "#/$defs/commit"},
    "capture_schema": {"$ref": "#/$defs/file"},
    "cases": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/case"}}
  },
  "$defs": {
    "commit": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "u64": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "file": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "size", "sha256"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "size": {"type": "integer", "minimum": 1},
        "sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "package": {
      "type": "object",
      "additionalProperties": false,
      "required": ["first_path", "file_count", "total_size", "package_sha256", "tensor_layout_sha256"],
      "properties": {
        "first_path": {"type": "string", "minLength": 1},
        "file_count": {"type": "integer", "minimum": 1, "maximum": 4294967295},
        "total_size": {"type": "integer", "minimum": 1},
        "package_sha256": {"$ref": "#/$defs/sha256"},
        "tensor_layout_sha256": {"$ref": "#/$defs/sha256"}
      }
    },
    "capture": {
      "type": "object",
      "additionalProperties": false,
      "required": ["profile_enabled", "generated_tokens_sha256", "logit_stream_sha256", "initial_resident_sha256", "route_stream_sha256", "prediction_stream_sha256", "summary"],
      "properties": {
        "profile_enabled": {"type": "boolean"},
        "generated_tokens_sha256": {"$ref": "#/$defs/sha256"},
        "logit_stream_sha256": {"$ref": "#/$defs/sha256"},
        "initial_resident_sha256": {"$ref": "#/$defs/sha256"},
        "route_stream_sha256": {"$ref": "#/$defs/sha256"},
        "prediction_stream_sha256": {"$ref": "#/$defs/sha256"},
        "summary": {"type": "object"}
      }
    },
    "agreement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tokens_exact", "logits_exact", "runtime_python_candidates_exact", "runtime_native_candidates_exact", "python_native_replay_exact", "predictor_state_exact", "runtime_replay_hierarchy_exact", "runtime_python_decisions_exact", "runtime_native_decisions_exact", "candidate_stream_sha256", "decision_stream_sha256", "predictor_state_digest"],
      "properties": {
        "tokens_exact": {"const": true},
        "logits_exact": {"const": true},
        "runtime_python_candidates_exact": {"const": true},
        "runtime_native_candidates_exact": {"const": true},
        "python_native_replay_exact": {"const": true},
        "predictor_state_exact": {"const": true},
        "runtime_replay_hierarchy_exact": {"const": true},
        "runtime_python_decisions_exact": {"const": true},
        "runtime_native_decisions_exact": {"const": true},
        "candidate_stream_sha256": {"$ref": "#/$defs/sha256"},
        "decision_stream_sha256": {"$ref": "#/$defs/sha256"},
        "predictor_state_digest": {"$ref": "#/$defs/u64"}
      }
    },
    "case": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "status", "runtime", "profile", "model", "raw_capture", "active", "disabled", "agreement"],
      "properties": {
        "name": {"type": "string", "minLength": 1},
        "status": {"const": "pass"},
        "runtime": {
          "type": "object",
          "additionalProperties": false,
          "required": ["cache_mode", "load_mode", "miss_policy", "hot_slots", "cold_slots"],
          "properties": {
            "cache_mode": {"enum": ["HOT_CACHE", "COLD_CACHE"]},
            "load_mode": {"enum": ["BUFFERED", "DIRECT_IO"]},
            "miss_policy": {"enum": ["PROMOTE_AND_GPU", "CPU_FALLBACK", "AUTO"]},
            "hot_slots": {"type": "integer", "minimum": 4, "maximum": 4294967295},
            "cold_slots": {"type": "integer", "minimum": 0, "maximum": 4294967295}
          }
        },
        "profile": {"$ref": "#/$defs/file"},
        "model": {"$ref": "#/$defs/package"},
        "raw_capture": {"$ref": "#/$defs/file"},
        "active": {"$ref": "#/$defs/capture"},
        "disabled": {"$ref": "#/$defs/capture"},
        "agreement": {"$ref": "#/$defs/agreement"}
      },
      "allOf": [
        {
          "if": {"properties": {"runtime": {"properties": {"cache_mode": {"const": "HOT_CACHE"}}}}},
          "then": {"properties": {"runtime": {"properties": {"cold_slots": {"const": 0}}}}},
          "else": {"properties": {"runtime": {"properties": {"cold_slots": {"minimum": 4}}}}}
        }
      ]
    }
  }
}
