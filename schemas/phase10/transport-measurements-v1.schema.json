{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "transport-measurements-v1.schema.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project_head", "nested_head", "host", "profile_sha256", "profile_parse_ns", "model_profile_load_ns", "lead_measurements", "predictor_upper_bound", "path_provenance", "envelopes"],
  "properties": {
    "schema_version": {"const": "phase10-transport-measurements-v1"},
    "project_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "nested_head": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "host": {"type": "string", "minLength": 1},
    "profile_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "profile_parse_ns": {"type": "integer", "minimum": 0},
    "model_profile_load_ns": {"type": "integer", "minimum": 0},
    "lead_measurements": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis", "decode_submissions", "token_end_samples", "cross_layer_samples", "token_end_p50_ns", "cross_layer_p50_ns", "conservative_lead_p50_ns", "provider_event_capacity", "provider_events_dropped"],
      "properties": {
        "basis": {"const": "minimum p50 of observed token-end-to-router and adjacent-router intervals"},
        "decode_submissions": {"type": "integer", "minimum": 1},
        "token_end_samples": {"type": "integer", "minimum": 1},
        "cross_layer_samples": {"type": "integer", "minimum": 1},
        "token_end_p50_ns": {"type": "integer", "minimum": 1},
        "cross_layer_p50_ns": {"type": "integer", "minimum": 1},
        "conservative_lead_p50_ns": {"type": "integer", "minimum": 1},
        "provider_event_capacity": {"type": "integer", "minimum": 1},
        "provider_events_dropped": {"const": 0}
      }
    },
    "predictor_upper_bound": {
      "type": "object",
      "additionalProperties": false,
      "required": ["basis", "upper_bound_p95_ns", "measurements"],
      "properties": {
        "basis": {"const": "maximum p95 over full-token topology-capped declared predictors"},
        "upper_bound_p95_ns": {"type": "integer", "minimum": 1},
        "measurements": {"type": "array", "minItems": 5, "maxItems": 5, "items": {"type": "object"}}
      }
    },
    "path_provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["storage_map_sha256", "model_sha256", "model_size", "exact_runtime_provider_path", "buffered", "direct"],
      "properties": {
        "storage_map_sha256": {"$ref": "#/$defs/sha256"},
        "model_sha256": {"$ref": "#/$defs/sha256"},
        "model_size": {"type": "integer", "minimum": 1},
        "exact_runtime_provider_path": {"const": true},
        "buffered": {"type": "object"},
        "direct": {"type": "object"}
      }
    },
    "envelopes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/envelope"}}
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "envelope": {
      "type": "object",
      "additionalProperties": false,
      "required": ["transport", "readiness", "supported", "lead_p50_ns", "demand_service_p50_ns", "speculative_service_p95_ns", "predictor_compute_p95_ns", "scheduler_demand_delay_p95_ns", "displacement_refill_p95_ns", "storage_bytes", "h2d_bytes", "utility_window_predictions", "utility_min_observations", "measurement_basis"],
      "properties": {
        "transport": {"enum": ["BUFFERED", "DIRECT_IO", "HOST_TO_DEVICE"]},
        "readiness": {"enum": ["HOST_READY", "DEVICE_READY"]},
        "supported": {"type": "boolean"},
        "lead_p50_ns": {"type": "integer", "minimum": 1},
        "demand_service_p50_ns": {"type": "integer", "minimum": 0},
        "speculative_service_p95_ns": {"type": "integer", "minimum": 0},
        "predictor_compute_p95_ns": {"type": "integer", "minimum": 1},
        "scheduler_demand_delay_p95_ns": {"type": "integer", "minimum": 0},
        "displacement_refill_p95_ns": {"type": "integer", "minimum": 0},
        "storage_bytes": {"type": "integer", "minimum": 0},
        "h2d_bytes": {"type": "integer", "minimum": 0},
        "utility_window_predictions": {"type": "integer", "minimum": 1},
        "utility_min_observations": {"type": "integer", "minimum": 1},
        "measurement_basis": {"type": "object"}
      }
    }
  }
}
