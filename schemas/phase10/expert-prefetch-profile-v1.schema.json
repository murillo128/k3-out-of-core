{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "expert-prefetch-profile-v1.schema.json",
  "title": "K3 expert prefetch profile v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "profile_id", "tool", "source", "target", "static_counts", "transitions", "costs", "selection", "seed"],
  "properties": {
    "schema_version": {"const": "expert-prefetch-profile-v1"},
    "profile_id": {"type": "string", "minLength": 1},
    "tool": {"type": "object", "additionalProperties": false, "required": ["name", "version"], "properties": {"name": {"type": "string", "minLength": 1}, "version": {"$ref": "#/$defs/u32"}}},
    "source": {"type": "object", "additionalProperties": false, "required": ["kind", "artifacts", "fold"], "properties": {
      "kind": {"enum": ["route_trace", "imatrix_derived"]},
      "artifacts": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
      "fold": {"$ref": "#/$defs/fold"}
    }},
    "target": {"$ref": "#/$defs/target"},
    "static_counts": {"type": "array", "items": {"$ref": "#/$defs/static_count"}},
    "transitions": {"type": "array", "items": {"$ref": "#/$defs/transition"}},
    "costs": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/cost"}},
    "selection": {"$ref": "#/$defs/selection"},
    "seed": {"type": "array", "items": {"$ref": "#/$defs/seed"}}
  },
  "$defs": {
    "u32": {"type": "integer", "minimum": 0, "maximum": 4294967295},
    "u64": {"type": "integer", "minimum": 0, "maximum": 18446744073709551615},
    "positive_u64": {"type": "integer", "minimum": 1, "maximum": 18446744073709551615},
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["name", "size", "sha256"], "properties": {"name": {"type": "string", "minLength": 1}, "size": {"$ref": "#/$defs/positive_u64"}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "fold": {"type": "object", "additionalProperties": false, "required": ["index", "training", "validation", "test", "training_rows", "validation_rows", "test_rows"], "properties": {
      "index": {"type": "integer", "minimum": 0, "maximum": 5}, "training": {"type": "array", "minItems": 4, "maxItems": 4, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
      "validation": {"type": "string", "minLength": 1}, "test": {"type": "string", "minLength": 1}, "training_rows": {"$ref": "#/$defs/positive_u64"}, "validation_rows": {"$ref": "#/$defs/positive_u64"}, "test_rows": {"$ref": "#/$defs/positive_u64"}
    }},
    "file": {"type": "object", "additionalProperties": false, "required": ["ordinal", "name", "size", "sha256"], "properties": {"ordinal": {"$ref": "#/$defs/u32"}, "name": {"type": "string", "minLength": 1}, "size": {"$ref": "#/$defs/positive_u64"}, "sha256": {"$ref": "#/$defs/sha256"}}},
    "key_bytes": {"type": "object", "additionalProperties": false, "required": ["layer", "expert", "payload_bytes", "physical_bytes"], "properties": {"layer": {"$ref": "#/$defs/u32"}, "expert": {"$ref": "#/$defs/u32"}, "payload_bytes": {"$ref": "#/$defs/positive_u64"}, "physical_bytes": {"$ref": "#/$defs/positive_u64"}}},
    "target": {"type": "object", "additionalProperties": false, "required": ["package_sha256", "files", "layer_count", "routed_layers", "experts_per_layer", "experts_per_token", "tensor_layout_sha256", "expert_bytes"], "properties": {
      "package_sha256": {"$ref": "#/$defs/sha256"}, "files": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/file"}}, "layer_count": {"$ref": "#/$defs/u32"},
      "routed_layers": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "#/$defs/u32"}}, "experts_per_layer": {"$ref": "#/$defs/u32"}, "experts_per_token": {"$ref": "#/$defs/u32"},
      "tensor_layout_sha256": {"$ref": "#/$defs/sha256"}, "expert_bytes": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/key_bytes"}}
    }},
    "static_count": {"type": "object", "additionalProperties": false, "required": ["layer", "expert", "count"], "properties": {"layer": {"$ref": "#/$defs/u32"}, "expert": {"$ref": "#/$defs/u32"}, "count": {"$ref": "#/$defs/positive_u64"}}},
    "transition": {"type": "object", "additionalProperties": false, "required": ["source_layer", "source_expert", "target_layer", "target_expert", "count"], "properties": {"source_layer": {"$ref": "#/$defs/u32"}, "source_expert": {"$ref": "#/$defs/u32"}, "target_layer": {"$ref": "#/$defs/u32"}, "target_expert": {"$ref": "#/$defs/u32"}, "count": {"$ref": "#/$defs/positive_u64"}}},
    "cost": {"type": "object", "additionalProperties": false, "required": ["transport", "readiness", "lead_ns", "demand_service_ns", "speculative_service_ns", "predictor_compute_ns", "scheduler_demand_delay_ns", "displacement_refill_ns", "storage_bytes", "h2d_bytes", "break_even_bps", "utility_window_predictions", "utility_min_observations", "utility_min_timely_successes"], "properties": {
      "transport": {"type": "string", "minLength": 1}, "readiness": {"enum": ["HOST_READY", "DEVICE_READY"]}, "lead_ns": {"$ref": "#/$defs/u64"}, "demand_service_ns": {"$ref": "#/$defs/u64"}, "speculative_service_ns": {"$ref": "#/$defs/u64"}, "predictor_compute_ns": {"$ref": "#/$defs/u64"}, "scheduler_demand_delay_ns": {"$ref": "#/$defs/u64"}, "displacement_refill_ns": {"$ref": "#/$defs/u64"}, "storage_bytes": {"$ref": "#/$defs/u64"}, "h2d_bytes": {"$ref": "#/$defs/u64"}, "break_even_bps": {"type": "integer", "minimum": 0, "maximum": 10000}, "utility_window_predictions": {"$ref": "#/$defs/u32"}, "utility_min_observations": {"$ref": "#/$defs/u32"}, "utility_min_timely_successes": {"$ref": "#/$defs/u32"}
    }},
    "selection": {"type": "object", "additionalProperties": false, "required": ["matrix_version", "tuning_digest", "fold_index", "candidates_per_target", "temporal_window_tokens", "transport", "readiness", "break_even_bps"], "properties": {"matrix_version": {"const": 1}, "tuning_digest": {"$ref": "#/$defs/sha256"}, "fold_index": {"type": "integer", "minimum": 0, "maximum": 5}, "candidates_per_target": {"$ref": "#/$defs/u32"}, "temporal_window_tokens": {"$ref": "#/$defs/u32"}, "transport": {"enum": ["BUFFERED", "DIRECT_IO", "HOST_TO_DEVICE"]}, "readiness": {"enum": ["HOST_READY", "DEVICE_READY"]}, "break_even_bps": {"type": "integer", "minimum": 0, "maximum": 10000}}},
    "seed": {"type": "object", "additionalProperties": false, "required": ["layer", "expert", "count", "payload_bytes", "physical_bytes"], "properties": {"layer": {"$ref": "#/$defs/u32"}, "expert": {"$ref": "#/$defs/u32"}, "count": {"$ref": "#/$defs/positive_u64"}, "payload_bytes": {"$ref": "#/$defs/positive_u64"}, "physical_bytes": {"$ref": "#/$defs/positive_u64"}}}
  }
}
