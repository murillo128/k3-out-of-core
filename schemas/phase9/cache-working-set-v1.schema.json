{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/murillo128/k3-out-of-core/schemas/phase9/cache-working-set-v1.schema.json",
  "title": "K3 cache working-set evidence version 1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "status", "inputs", "headroom", "cases", "full_k3_mxfp4"],
  "properties": {
    "schema_version": {"const": "cache-working-set-v1"},
    "status": {"const": "pass"},
    "inputs": {"type": "object", "required": ["online", "synthetic_store"]},
    "headroom": {"type": "object", "required": ["physical_bytes", "available_bytes", "reserve_bytes", "safe_ceiling_bytes"]},
    "cases": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["name", "model", "capture", "observed_capacities", "derivation", "one_expert_footprint_bytes",
          "distinct_key_count", "token_working_set_bytes", "checkpoint_working_set_bytes",
          "theoretical_token_working_set_bytes", "protected_decode_set_bytes", "reuse_distance",
          "per_layer_demand_occurrences", "per_layer_max_simultaneous_unique", "cold_budget_grid"]
      }
    },
    "full_k3_mxfp4": {
      "type": "object",
      "required": ["descriptor", "descriptor_constants_verified", "one_expert_footprint_bytes",
        "theoretical_token_working_set_bytes", "budget_grid", "scope_limit"]
    }
  }
}
