{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/murillo128/k3-out-of-core/schemas/phase8/phase8-manifest-v1.schema.json",
  "title": "K3 out-of-core Phase 8 closeout manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "closeout_state", "execution_profile", "issue", "revisions", "checkpoint_a", "checkpoint_b", "final_review", "inputs", "environment", "evidence", "validation", "policies", "metrics", "gates", "carried_notes", "deferred", "artifacts"],
  "properties": {
    "schema_version": {"const": "phase8-manifest-v1"},
    "closeout_state": {"enum": ["final-review-candidate", "accepted"]},
    "execution_profile": {"const": "STANDARD"},
    "issue": {"type": "object", "additionalProperties": false, "required": ["repository", "number", "pull_request"], "properties": {"repository": {"const": "murillo128/k3-out-of-core"}, "number": {"const": 26}, "pull_request": {"const": 27}}},
    "revisions": {"type": "object", "additionalProperties": false, "required": ["branch", "project_execution_base", "project_phase8_4_start", "project_capture_head", "project_evidence_head", "llama_cpp_base", "llama_cpp_final", "gitlink"], "properties": {"branch": {"const": "codex/phase8-miss-execution"}, "project_execution_base": {"$ref": "#/$defs/sha"}, "project_phase8_4_start": {"$ref": "#/$defs/sha"}, "project_capture_head": {"$ref": "#/$defs/sha"}, "project_evidence_head": {"$ref": "#/$defs/sha"}, "llama_cpp_base": {"$ref": "#/$defs/sha"}, "llama_cpp_final": {"$ref": "#/$defs/sha"}, "gitlink": {"$ref": "#/$defs/sha"}}},
    "checkpoint_a": {"$ref": "#/$defs/checkpoint"},
    "checkpoint_b": {"$ref": "#/$defs/checkpoint"},
    "final_review": {"oneOf": [{"type": "null"}, {"$ref": "#/$defs/checkpoint"}]},
    "inputs": {"type": "object", "additionalProperties": false, "required": ["phase7_manifest", "phase7_final_review_comment", "k3_models", "larger_public_moe", "synthetic_store"], "properties": {"phase7_manifest": {"$ref": "#/$defs/identity"}, "phase7_final_review_comment": {"const": 5140690363}, "k3_models": {"type": "array", "minItems": 4, "maxItems": 4}, "larger_public_moe": {"type": "object", "required": ["repository", "source_revision", "config", "tokenizer", "gguf", "converter_head", "conversion_command"]}, "synthetic_store": {"$ref": "#/$defs/identity"}}},
    "environment": {"type": "object", "minProperties": 10},
    "evidence": {"type": "object", "additionalProperties": false, "required": ["checkpoint_b_probe", "miss_policy_parity", "hybrid_overlap", "miss_policy_benchmarks", "synthetic_store", "validation_results"], "properties": {"checkpoint_b_probe": {"$ref": "#/$defs/identity"}, "miss_policy_parity": {"$ref": "#/$defs/identity"}, "hybrid_overlap": {"$ref": "#/$defs/identity"}, "miss_policy_benchmarks": {"$ref": "#/$defs/identity"}, "synthetic_store": {"$ref": "#/$defs/identity"}, "validation_results": {"$ref": "#/$defs/identity"}}},
    "validation": {"type": "array", "minItems": 15, "items": {"$ref": "#/$defs/command"}},
    "policies": {"type": "object", "additionalProperties": false, "required": ["default", "cpu_fallback_explicit", "auto_explicit_version", "background_promotion_default", "cost_model_digests_recorded"], "properties": {"default": {"const": "PROMOTE_AND_GPU"}, "cpu_fallback_explicit": {"const": true}, "auto_explicit_version": {"const": 1}, "background_promotion_default": {"const": false}, "cost_model_digests_recorded": {"const": true}}},
    "metrics": {"type": "object", "minProperties": 6},
    "gates": {"type": "object", "additionalProperties": false, "required": ["original_split_k3_numerical", "larger_public_moe", "exact_size_synthetic_store", "mixed_cpu_gpu_overlap", "auto_independent_evaluator", "cpu_and_gpu_favorable_regimes", "background_bounded_and_truthful", "failure_and_unload_drain", "default_and_prior_modes", "tails_and_resources", "sanitizers_and_thread_safety", "checkpoint_a_accepted", "checkpoint_b_accepted", "scope_lineage_and_whitespace"], "properties": {"original_split_k3_numerical": {"const": true}, "larger_public_moe": {"const": true}, "exact_size_synthetic_store": {"const": true}, "mixed_cpu_gpu_overlap": {"const": true}, "auto_independent_evaluator": {"const": true}, "cpu_and_gpu_favorable_regimes": {"const": true}, "background_bounded_and_truthful": {"const": true}, "failure_and_unload_drain": {"const": true}, "default_and_prior_modes": {"const": true}, "tails_and_resources": {"const": true}, "sanitizers_and_thread_safety": {"const": true}, "checkpoint_a_accepted": {"const": true}, "checkpoint_b_accepted": {"const": true}, "scope_lineage_and_whitespace": {"const": true}}},
    "carried_notes": {"type": "array", "minItems": 4, "items": {"type": "string"}},
    "deferred": {"type": "array", "minItems": 4, "items": {"type": "string"}},
    "artifacts": {"type": "array", "minItems": 20, "items": {"$ref": "#/$defs/identity"}}
  },
  "$defs": {
    "sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "identity": {"type": "object", "additionalProperties": false, "required": ["path", "size", "sha256"], "properties": {"path": {"type": "string", "minLength": 1}, "size": {"type": "integer", "minimum": 1}, "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}},
    "checkpoint": {"type": "object", "additionalProperties": false, "required": ["comment_id", "verdict", "safety_to_proceed", "project_head", "llama_cpp_head", "independent_read_only"], "properties": {"comment_id": {"type": "integer", "minimum": 1}, "verdict": {"enum": ["PASS", "PASS_WITH_NOTES"]}, "safety_to_proceed": {"const": "YES"}, "project_head": {"$ref": "#/$defs/sha"}, "llama_cpp_head": {"$ref": "#/$defs/sha"}, "independent_read_only": {"const": true}}},
    "command": {"type": "object", "required": ["name", "command", "cwd", "duration_ms", "exit_code", "stdout_sha256", "stderr_sha256", "stdout_tail", "stderr_tail", "required"], "properties": {"name": {"type": "string"}, "command": {"type": "array", "minItems": 1, "items": {"type": "string"}}, "cwd": {"type": "string"}, "duration_ms": {"type": "integer", "minimum": 0}, "exit_code": {"type": "integer"}, "stdout_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "stderr_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}, "stdout_tail": {"type": "array", "items": {"type": "string"}}, "stderr_tail": {"type": "array", "items": {"type": "string"}}, "required": {"type": "boolean"}}}
  }
}
