{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://github.com/murillo128/k3-out-of-core/schemas/phase13/exact-topm-capture-v1.schema.json",
  "title": "Phase 13 exact-reference top-M route capture v1",
  "type": "object",
  "required": [
    "schema_version",
    "status",
    "model_path",
    "candidate_count",
    "prompt_ids",
    "execution",
    "sampling",
    "generated_ids",
    "observer_stats",
    "routes"
  ],
  "properties": {
    "schema_version": {"const": "phase13-exact-topm-capture-v1"},
    "status": {"const": "pass"},
    "model_path": {"type": "string", "minLength": 1},
    "candidate_count": {"type": "integer", "minimum": 1, "maximum": 64},
    "prompt_ids": {"type": "array", "items": {"type": "integer"}},
    "execution": {
      "type": "object",
      "required": ["backend", "n_gpu_layers", "weight_repacking", "n_ctx", "n_batch", "n_ubatch", "threads"],
      "properties": {
        "backend": {"const": "CPU"},
        "n_gpu_layers": {"const": 0},
        "weight_repacking": {"const": false},
        "n_ctx": {"type": "integer", "minimum": 1},
        "n_batch": {"type": "integer", "minimum": 1},
        "n_ubatch": {"type": "integer", "minimum": 1},
        "threads": {"type": "integer", "minimum": 1}
      },
      "additionalProperties": false
    },
    "sampling": {
      "type": "object",
      "required": ["temperature", "selection"],
      "properties": {
        "temperature": {"const": 0.0},
        "selection": {"const": "argmax"},
        "teacher_forced": {"type": "boolean"}
      },
      "additionalProperties": false
    },
    "generated_ids": {"type": "array", "items": {"type": "integer"}},
    "argmax_ids": {"type": "array", "items": {"type": "integer"}},
    "teacher_forced_ids": {"type": "array", "items": {"type": "integer", "minimum": 0}},
    "quality_trace": {
      "type": "object",
      "required": [
        "enabled", "path", "capture_internal_phase", "records", "moe_records",
        "hidden_records", "logits_records", "payload_bytes", "file_bytes", "failures"
      ],
      "properties": {
        "enabled": {"type": "boolean"},
        "path": {"type": "string"},
        "capture_internal_phase": {"const": "DECODE"},
        "records": {"type": "integer", "minimum": 0},
        "moe_records": {"type": "integer", "minimum": 0},
        "hidden_records": {"type": "integer", "minimum": 0},
        "logits_records": {"type": "integer", "minimum": 0},
        "payload_bytes": {"type": "integer", "minimum": 0},
        "file_bytes": {"type": "integer", "minimum": 0},
        "failures": {"const": 0}
      },
      "additionalProperties": false
    },
    "cache_aware_routing": {
      "type": "object",
      "required": ["enabled", "candidate_count", "capacity_slots", "max_swaps", "max_score_regret", "prefill_rerouting", "tier_source", "stats", "cache"],
      "properties": {
        "enabled": {"type": "boolean"},
        "candidate_count": {"type": "integer", "minimum": 1, "maximum": 64},
        "capacity_slots": {"type": "integer", "minimum": 0},
        "max_swaps": {"type": "integer", "minimum": 0, "maximum": 16},
        "max_score_regret": {"type": "number", "minimum": 0},
        "prefill_rerouting": {"const": false},
        "tier_source": {"type": "string", "minLength": 1},
        "stats": {"type": "object"},
        "cache": {"type": "object"}
      },
      "additionalProperties": false
    },
    "observer_stats": {
      "type": "object",
      "required": ["ubatches", "layers", "copy_bytes", "explicit_synchronizations", "failures"],
      "properties": {
        "ubatches": {"type": "integer", "minimum": 1},
        "layers": {"type": "integer", "minimum": 1},
        "copy_bytes": {"type": "integer", "minimum": 1},
        "explicit_synchronizations": {"type": "integer", "minimum": 1},
        "failures": {"const": 0}
      },
      "additionalProperties": false
    },
    "routes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "request_ordinal",
          "ubatch_ordinal",
          "phase",
          "layer",
          "n_tokens",
          "n_expert_used",
          "n_candidates",
          "positions",
          "selected_experts",
          "weights",
          "candidate_experts",
          "candidate_selection_scores",
          "candidate_probabilities"
        ],
        "properties": {
          "request_ordinal": {"type": "integer", "minimum": 0},
          "ubatch_ordinal": {"type": "integer", "minimum": 0},
          "phase": {"enum": ["PREFILL", "DECODE"]},
          "layer": {"type": "integer", "minimum": 0},
          "n_tokens": {"type": "integer", "minimum": 1},
          "n_expert_used": {"type": "integer", "minimum": 1},
          "n_candidates": {"type": "integer", "minimum": 1, "maximum": 64},
          "positions": {"type": "array", "items": {"type": "integer", "minimum": 0}},
          "selected_experts": {"type": "array", "items": {"type": "integer", "minimum": 0}},
          "weights": {"$ref": "#/definitions/finiteNumbers"},
          "candidate_experts": {"type": "array", "items": {"type": "integer", "minimum": 0}},
          "candidate_selection_scores": {"$ref": "#/definitions/finiteNumbers"},
          "candidate_probabilities": {"$ref": "#/definitions/finiteNumbers"}
        },
        "additionalProperties": false
      }
    }
  },
  "definitions": {
    "finiteNumbers": {
      "type": "array",
      "items": {"type": "number"}
    }
  },
  "additionalProperties": true
}
