{
  "$id": "https://github.com/murillo128/k3-out-of-core/schemas/issue105/source-catalog-v1.schema.json",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "archive_member_original_path": {
      "type": "string"
    },
    "authority_scope": {
      "type": "string"
    },
    "bytes": {
      "minimum": 0,
      "type": "integer"
    },
    "case_run_identity": {
      "type": "string"
    },
    "policy": {
      "type": "string"
    },
    "protocol": {
      "type": "string"
    },
    "reason": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "sha256": {
      "pattern": "^[0-9a-f]{64}$",
      "type": "string"
    },
    "source_evidence_class": {
      "enum": [
        "MEASURED_PHYSICAL",
        "MEASURED_OBSERVER",
        "CURATED_FROM_MEASURED",
        "EXACT_REPLAY",
        "FIXED_ROUTE_COUNTERFACTUAL",
        "EXACT_REPLAY_COUNTERFACTUAL",
        "TPS_PROJECTION",
        "SEMANTIC_SANITY",
        "POST_HOC_EXPLORATORY"
      ]
    },
    "source_issue_release": {
      "type": "string"
    },
    "status": {
      "enum": [
        "accepted",
        "missing",
        "failed",
        "superseded",
        "contextual_non_authoritative"
      ]
    },
    "superseded_by": {
      "type": "string"
    },
    "supersedes": {
      "type": "string"
    }
  },
  "required": [
    "source_issue_release",
    "archive_member_original_path",
    "sha256",
    "bytes",
    "schema_version",
    "case_run_identity",
    "protocol",
    "policy",
    "source_evidence_class",
    "authority_scope",
    "status",
    "reason",
    "supersedes",
    "superseded_by"
  ],
  "title": "Issue 105 source catalog row",
  "type": "object"
}
